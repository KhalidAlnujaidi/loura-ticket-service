    {
      "dot": "violet",
      "title": "Model boundary",
      "items": [
        "Every backend returns text through one gate",
        "Extract JSON → strict Pydantic: Literal enums · summary ≤ 300 · extra=forbid",
        "Reject → retry (≤ 3 attempts) → failed; raw output logged, never stored"
      ]
    },
    {
